# Demo settings. Copy the core block to core/.env and the web block to
# web/.env.local, or just run demo/run.sh which exports them for you.
# None of these are secrets: they point at local stand-ins.

# ---- core
ENVIRONMENT=development
API_KEY=demo-api-key
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:55471/fubuu
REDIS_URL=redis://127.0.0.1:56391/0
CELERY_BROKER_URL=redis://127.0.0.1:56391/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:56391/0
OPENAI_API_KEY=demo
OPENAI_BASE_URL=http://127.0.0.1:18793/v1
GEMINI_API_KEY=demo
CLERK_SECRET_KEY=demo
CLERK_API_URL=http://127.0.0.1:18793/v1
X_API_BASE_URL=http://127.0.0.1:18793
LINKEDIN_API_BASE_URL=http://127.0.0.1:18793
THREADS_API_BASE_URL=http://127.0.0.1:18793
TWILIO_ACCOUNT_SID=ACdemo
TWILIO_AUTH_TOKEN=demo
TWILIO_WHATSAPP_NUMBER=+15555550100
TWILIO_API_BASE_URL=http://127.0.0.1:18793

# ---- web
FUBUU_DEMO=1
DATABASE_URL_WEB=postgresql://postgres:postgres@db.localtest.me:4471/fubuu
