# Fubuu core (FastAPI + Celery). Every value is blank on purpose: fill in your own.
ENVIRONMENT=development
API_KEY=                     # shared secret the web app sends as X-API-Key

# Storage
DATABASE_URL=                # postgresql+psycopg2://user:pass@host:5432/db (same DB as web/)
REDIS_URL=                   # redis://host:6379/0, used for rate limits and the message queue
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI
OPENAI_API_KEY=              # Whisper transcription + post writing
OPENAI_MODEL=o3-mini
GEMINI_API_KEY=

# Auth: Clerk holds each user's X / LinkedIn / Threads OAuth tokens
CLERK_SECRET_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WELCOME_TEMPLATE_SID=
TWILIO_UNREGISTERED_USER_TEMPLATE_SID=
TWILIO_UPGRADE_TEMPLATE_SID=
TWILIO_24H_REMINDER_TEMPLATE_SID=
TWILIO_DAY1_TEMPLATE_SID=
TWILIO_DAY3_TEMPLATE_SID=
TWILIO_DAY7_TEMPLATE_SID=
TWILIO_WEEK2_TEMPLATE_SID=
TWILIO_MONTH1_TEMPLATE_SID=
TWILIO_MONTH3_TEMPLATE_SID=

# Daily posting limits per platform
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_X=10
RATE_LIMIT_THREADS=1
RATE_LIMIT_LINKEDIN=1

# Reminder scheduler (seconds)
PRODUCE_INTERVAL_SECONDS=3600
CONSUME_INTERVAL_SECONDS=60

# Optional
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000
SUPPORT_PHONE=
COMMUNITY_LINK=

# Optional overrides, e.g. to point at demo/fake_services.py
X_API_BASE_URL=
LINKEDIN_API_BASE_URL=
THREADS_API_BASE_URL=
CLERK_API_URL=
TWILIO_API_BASE_URL=
OPENAI_BASE_URL=
