# Fubuu web (Next.js). Every value is blank on purpose: fill in your own.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon serverless driver). For local Postgres, run src/db/docker-compose.yml
# and set LOCAL_DB_HTTP_ENDPOINT=http://127.0.0.1:4444/sql
DATABASE_URL=
LOCAL_DB_HTTP_ENDPOINT=

# Clerk (sign-in + X / LinkedIn / Threads OAuth connections)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SIGNING_SECRET=              # Clerk webhook signing secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=             # optional, points Stripe at a local stub
NEXT_PUBLIC_STRIPE_PAYMENT_LINK1=

# Fubuu core backend
FUBUU_CORE_API_URL=
FUBUU_CORE_API_KEY=

# Shown to users
NEXT_PUBLIC_WHATSAPP_NUMBER=   # the Twilio number users send voice notes to
NEXT_PUBLIC_SUPPORT_WHATSAPP=  # optional, for the "Book demo" button
NEXT_PUBLIC_AUTHORIZED_EMAILS=

# FUBUU_DEMO=1 replaces Clerk with an invented local user (see src/demo/)
FUBUU_DEMO=
